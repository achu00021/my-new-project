// Contrarian Cipher B v2
// ----------------------
// A contrarian trading indicator built on top of the latest public VuManChu
// Cipher B (v2, "Cipher B Divergences") core components:
//   - WaveTrend oscillator (WT1 / WT2 + VWAP area)
//   - Money Flow area (RSI-MFI hybrid)
//   - RSI and Stochastic RSI
//   - Fractal-based divergence detection (regular divergences)
//
// v2 quality upgrades (designed to raise signal quality on ALL timeframes):
//   - ADAPTIVE OB/OS LEVELS: WaveTrend thresholds are computed from the
//     recent distribution (percentile rank) instead of fixed +-53/+-60, so
//     the indicator self-calibrates to any timeframe and any asset.
//   - HTF CONFIRMATION: contrarian longs are blocked when the higher
//     timeframe WaveTrend is still overbought (and vice versa), so you only
//     fade extremes that are aligned with the bigger picture.
//   - ADX TREND FILTER: contrarian signals are suppressed when a strong
//     trend (high ADX + DI direction against the trade) is running them
//     over. Fading a freight train is the #1 mean-reversion account killer.
//   - PRICE STRETCH: distance from a long EMA measured in ATRs feeds the
//     extremity score, so signals need genuine overextension, not just an
//     oscillator wiggle.
//   - CONFIRMATION CANDLE + COOLDOWN: optional candle-close confirmation
//     and a minimum spacing between signals to avoid clustered losses.
//
// A companion strategy script (contrarian-cipher-b-strategy.pine) implements
// the same engine with ATR stops/targets so the winrate can be MEASURED in
// TradingView's Strategy Tester on any symbol and timeframe.
//
// Credits: WaveTrend / Cipher B concepts by VuManChu (Cipher B Divergences),
// which itself builds on LazyBear's WaveTrend oscillator. This is an
// independent re-implementation with a contrarian signal engine added.

//@version=6
indicator('Contrarian Cipher B v2 [VuManChu based]', shorttitle = 'Contrarian Cipher B v2', overlay = false, max_labels_count = 500)

// ============================================================================
// INPUTS
// ============================================================================

// --- WaveTrend (Cipher B core) ---
grpWT = 'WaveTrend (Cipher B core)'
wtChannelLen = input.int(9,  'WT Channel Length', minval = 1, group = grpWT)
wtAverageLen = input.int(12, 'WT Average Length', minval = 1, group = grpWT)
wtMALen      = input.int(3,  'WT MA Length',      minval = 1, group = grpWT)
wtMASource   = input.source(hlc3, 'WT Source', group = grpWT)

// --- Adaptive levels ---
grpAdp = 'Adaptive OB/OS Levels'
useAdaptive  = input.bool(true, 'Use Adaptive Levels (recommended for all timeframes)', group = grpAdp,
     tooltip = 'Derives overbought/oversold thresholds from the recent WaveTrend distribution (percentile rank) instead of fixed levels. Self-calibrates to any timeframe and asset.')
adaptLookback = input.int(300, 'Adaptive Lookback (bars)', minval = 50, group = grpAdp)
adaptPct1     = input.float(85, 'Level 1 Percentile', minval = 60, maxval = 99, group = grpAdp)
adaptPct2     = input.float(95, 'Level 2 (extreme) Percentile', minval = 70, maxval = 99.9, group = grpAdp)
adaptFloor    = input.float(30, 'Minimum Level Magnitude (floor)', minval = 0, group = grpAdp,
     tooltip = 'Adaptive levels never come closer to zero than this, preventing over-triggering in dead, rangebound markets.')
obLevel1     = input.int(53,  'Fixed Overbought Level 1', group = grpAdp)
obLevel2     = input.int(60,  'Fixed Overbought Level 2 (extreme)', group = grpAdp)
osLevel1     = input.int(-53, 'Fixed Oversold Level 1', group = grpAdp)
osLevel2     = input.int(-60, 'Fixed Oversold Level 2 (extreme)', group = grpAdp)

// --- Money Flow ---
grpMF = 'Money Flow (RSI-MFI)'
mfiPeriod     = input.int(60,      'MFI Period', minval = 1, group = grpMF)
mfiMultiplier = input.float(150.0, 'MFI Area Multiplier', step = 10, group = grpMF)
mfiExtreme    = input.float(15.0,  'MFI Extreme Threshold (contrarian)', minval = 0, group = grpMF)

// --- RSI / Stoch RSI ---
grpRSI = 'RSI & Stochastic RSI'
rsiLen        = input.int(14, 'RSI Length',    minval = 1, group = grpRSI)
rsiOversold   = input.int(30, 'RSI Oversold',   maxval = 50, group = grpRSI)
rsiOverbought = input.int(60, 'RSI Overbought', minval = 50, group = grpRSI)
stochUseLog   = input.bool(true, 'Stoch RSI: Use Log Scale', group = grpRSI)
stochLen      = input.int(14, 'Stoch Length',     minval = 1, group = grpRSI)
stochRsiLen   = input.int(14, 'Stoch RSI Length', minval = 1, group = grpRSI)
stochKSmooth  = input.int(3,  'Stoch K Smooth',   minval = 1, group = grpRSI)
stochDSmooth  = input.int(3,  'Stoch D Smooth',   minval = 1, group = grpRSI)

// --- Divergences ---
grpDiv = 'Divergences'
showWTDiv    = input.bool(true,  'Show WaveTrend Divergences', group = grpDiv)
showRSIDiv   = input.bool(false, 'Show RSI Divergences',       group = grpDiv)
divUseLimits = input.bool(true, 'Only Detect Divergences At Extremes', group = grpDiv)

// --- Quality filters (v2) ---
grpFlt = 'Quality Filters'
useHTF    = input.bool(true, 'Higher Timeframe Confirmation', group = grpFlt,
     tooltip = 'Blocks contrarian longs while the higher timeframe WaveTrend is overbought, and shorts while it is oversold. Aligns fades with the bigger picture.')
htfAuto   = input.bool(true, 'Auto HTF (4x current timeframe)', group = grpFlt)
htfManual = input.timeframe('240', 'Manual HTF', group = grpFlt)
htfBlock  = input.float(40, 'HTF Blocking Level', minval = 0, group = grpFlt,
     tooltip = 'Longs are blocked when the HTF WaveTrend is above this level; shorts are blocked when below its negative.')
useADX    = input.bool(true, 'ADX Trend Filter (avoid fading strong trends)', group = grpFlt)
adxLen    = input.int(14, 'ADX / DI Length', minval = 1, group = grpFlt)
adxMax    = input.float(35, 'Max ADX To Allow Counter-Trend Signal', minval = 10, group = grpFlt,
     tooltip = 'When ADX is above this AND the DI direction is against the signal, the signal is suppressed.')
useCandleConfirm = input.bool(true, 'Require Confirmation Candle', group = grpFlt,
     tooltip = 'A contrarian buy requires the trigger bar to close up; a sell requires it to close down. Avoids catching falling knives.')
cooldownBars = input.int(10, 'Signal Cooldown (bars)', minval = 0, group = grpFlt,
     tooltip = 'Minimum bars between contrarian signals in the same direction. Prevents clustered repeat losses in extended moves.')

// --- Trend / stretch context ---
grpTrd = 'Trend & Stretch Context'
trendLen   = input.int(200, 'Baseline EMA Length', minval = 10, group = grpTrd)
atrLen     = input.int(14,  'ATR Length', minval = 1, group = grpTrd)
stretchMin = input.float(1.5, 'Min Stretch From EMA (ATRs) For Full Score', minval = 0, step = 0.25, group = grpTrd,
     tooltip = 'Price must be at least this many ATRs away from the baseline EMA for the stretch component of the extremity score to activate.')

// --- Contrarian engine ---
grpCon = 'Contrarian Engine'
conThreshold   = input.int(60, 'Crowd Extremity Score Threshold', minval = 0, maxval = 100, group = grpCon,
     tooltip = 'Minimum extremity score (0-100) required before a contrarian signal can fire. Higher = fewer, stronger signals.')
conNeedDiv     = input.bool(false, 'Require Divergence For Contrarian Signals', group = grpCon,
     tooltip = 'If enabled, a contrarian buy needs a recent bullish divergence and a contrarian sell needs a recent bearish divergence. Enable for maximum selectivity.')
conDivLookback = input.int(10, 'Divergence Lookback (bars)', minval = 1, group = grpCon)
conStreakLen   = input.int(5, 'Capitulation / Euphoria Streak (bars)', minval = 2, group = grpCon)
showFadeMode   = input.bool(true, 'Fade Mode: Flag Classic Signals At Extremes', group = grpCon)
showScore      = input.bool(true, 'Show Crowd Extremity Score Line', group = grpCon)

// --- Display ---
grpDsp = 'Display'
showClassicCircles = input.bool(true, 'Show Classic Cipher B Buy/Sell Circles', group = grpDsp)
showLabels         = input.bool(true, 'Show Contrarian Signal Labels', group = grpDsp)

// --- Alerts ---
grpAlr = 'Alerts'
alertOnBuy    = input.bool(true,  'Alert: Contrarian Buy',  group = grpAlr)
alertOnSell   = input.bool(true,  'Alert: Contrarian Sell', group = grpAlr)
alertOnStrong = input.bool(true,  'Alert: Strong Signals',  group = grpAlr)
alertOnDiv    = input.bool(false, 'Alert: Divergences',     group = grpAlr)
alertOnFade   = input.bool(false, 'Alert: Fade Warnings',   group = grpAlr,
     tooltip = 'These toggles control the dynamic alert() messages. Create ONE alert in TradingView with condition "Any alert() function call" and it will cover everything enabled here, with ticker/timeframe/price/score filled in automatically.')

// --- Position sizing (alerts & table) ---
grpSiz = 'Position Sizing'
accountSize = input.float(1000, 'Account Size ($)', minval = 1, group = grpSiz)
riskPct     = input.float(3.0,  'Risk Per Trade (% of account)', minval = 0.1, maxval = 100, step = 0.5, group = grpSiz,
     tooltip = 'Alerts and the table show the position size where hitting the stop loses exactly this % of the account: qty = account × risk% ÷ stop distance.')
leverageX   = input.float(10, 'Leverage (for margin / liquidation info)', minval = 1, maxval = 125, group = grpSiz,
     tooltip = 'Only affects the displayed margin and the liquidation buffer check (approx. liq distance = 100% / leverage). It does not change risk if the stop is respected.')
compoundEquity = input.bool(true, 'Compound Simulated Equity', group = grpSiz,
     tooltip = 'Sizes each new signal from the running simulated balance (start = Account Size, adjusted by every resolved TP/SL trade in the winrate table) instead of the fixed account size. Only active in ATR Stop/Target evaluation mode. The strategy script always compounds via strategy.equity.')

// --- Winrate table ---
grpTbl = 'Winrate Table'
showWinTable = input.bool(true, 'Show Signal Winrate Table', group = grpTbl)
evalModeStr  = input.string('ATR Stop/Target', 'Evaluation Mode', options = ['ATR Stop/Target', 'Fixed Horizon'], group = grpTbl,
     tooltip = 'ATR Stop/Target: each signal is scored by which bracket level is touched first — take profit (win) or stop loss (loss) — exactly like a real bracket order. Matches the strategy script. Fixed Horizon: a signal wins if price simply closed favorably N bars later.')
tblAtrStop   = input.float(2.0, 'Table: Stop Loss (ATR multiple)',   minval = 0.25, step = 0.25, group = grpTbl)
tblAtrTgt    = input.float(2.0, 'Table: Take Profit (ATR multiple)', minval = 0.25, step = 0.25, group = grpTbl)
tblTimeout   = input.int(100, 'Table: Max Bars Per Trade (timeout)', minval = 5, group = grpTbl,
     tooltip = 'If neither the stop nor the target is touched within this many bars, the trade is scored at the current close.')
winHorizon   = input.int(20, 'Fixed Horizon (bars)', minval = 1, group = grpTbl,
     tooltip = 'Used only in Fixed Horizon mode: a buy wins if price closes higher this many bars later (lower for sells).')
tblPosStr    = input.string('Top Right', 'Table Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = grpTbl)

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

f_topFractal(series float src) =>
    src[4] < src[2] and src[3] < src[2] and src[2] > src[1] and src[2] > src[0]

f_botFractal(series float src) =>
    src[4] > src[2] and src[3] > src[2] and src[2] < src[1] and src[2] < src[0]

// Regular divergence detection on any oscillator source
f_findDivs(series float src, series float topLimit, series float botLimit, bool useLimits) =>
    isTop = f_topFractal(src) and (useLimits ? src[2] >= topLimit : true)
    isBot = f_botFractal(src) and (useLimits ? src[2] <= botLimit : true)
    prevTopVal   = ta.valuewhen(isTop, src[2],  0)[2]
    prevTopPrice = ta.valuewhen(isTop, high[2], 0)[2]
    prevBotVal   = ta.valuewhen(isBot, src[2],  0)[2]
    prevBotPrice = ta.valuewhen(isBot, low[2],  0)[2]
    bearDiv = isTop and high[2] > prevTopPrice and src[2] < prevTopVal
    bullDiv = isBot and low[2]  < prevBotPrice and src[2] > prevBotVal
    [bearDiv, bullDiv]

// WaveTrend oscillator (Cipher B core)
f_wavetrend(series float src, simple int chLen, simple int avgLen, simple int maLen) =>
    esa = ta.ema(src, chLen)
    de  = ta.ema(math.abs(src - esa), chLen)
    ci  = (src - esa) / (0.015 * de)
    wt1 = ta.ema(ci, avgLen)
    wt2 = ta.sma(wt1, maLen)
    [wt1, wt2]

// RSI-MFI hybrid money flow area (Cipher B style)
f_rsimfi(simple int period, simple float multiplier) =>
    candleRange = math.max(high - low, syminfo.mintick)
    ta.sma(((close - open) / candleRange) * multiplier, period)

// ============================================================================
// CALCULATIONS
// ============================================================================

// WaveTrend
[wt1, wt2] = f_wavetrend(wtMASource, wtChannelLen, wtAverageLen, wtMALen)
wtVwap      = wt1 - wt2
wtCrossUp   = ta.crossover(wt1, wt2)
wtCrossDown = ta.crossunder(wt1, wt2)

// Adaptive OB/OS levels: percentile of the recent WT2 distribution,
// clamped away from zero by the floor so quiet ranges do not over-trigger.
dynOB1 = nz(ta.percentile_nearest_rank(wt2, adaptLookback, adaptPct1), obLevel1)
dynOB2 = nz(ta.percentile_nearest_rank(wt2, adaptLookback, adaptPct2), obLevel2)
dynOS1 = nz(ta.percentile_nearest_rank(wt2, adaptLookback, 100 - adaptPct1), osLevel1)
dynOS2 = nz(ta.percentile_nearest_rank(wt2, adaptLookback, 100 - adaptPct2), osLevel2)

effOB1 = useAdaptive ? math.max(dynOB1,  adaptFloor) : obLevel1
effOB2 = useAdaptive ? math.max(dynOB2,  adaptFloor) : obLevel2
effOS1 = useAdaptive ? math.min(dynOS1, -adaptFloor) : osLevel1
effOS2 = useAdaptive ? math.min(dynOS2, -adaptFloor) : osLevel2

wtOversold   = wt2 <= effOS1
wtOverbought = wt2 >= effOB1
wtExtremeOS  = wt2 <= effOS2
wtExtremeOB  = wt2 >= effOB2

// Money Flow
moneyFlow    = f_rsimfi(mfiPeriod, mfiMultiplier)
mfExtremeNeg = moneyFlow <= -mfiExtreme
mfExtremePos = moneyFlow >=  mfiExtreme

// RSI
rsi = ta.rsi(close, rsiLen)

// Stoch RSI
stochSrc = stochUseLog ? math.log(close) : close
stochRsi = ta.rsi(stochSrc, stochRsiLen)
stochK   = ta.sma(ta.stoch(stochRsi, stochRsi, stochRsi, stochLen), stochKSmooth)
stochD   = ta.sma(stochK, stochDSmooth)
plot(stochK, 'Stoch RSI K (hidden by default)', color = color.new(#2196f3, 100), display = display.none)
plot(stochD, 'Stoch RSI D (hidden by default)', color = color.new(#ff9800, 100), display = display.none)

// Divergences (detected against the effective, adaptive extreme levels)
[wtBearDiv,  wtBullDiv]  = f_findDivs(wt2, effOB1, effOS1, divUseLimits)
[rsiBearDiv, rsiBullDiv] = f_findDivs(rsi, 60, 30, divUseLimits)

anyBullDiv = (showWTDiv and wtBullDiv) or (showRSIDiv and rsiBullDiv)
anyBearDiv = (showWTDiv and wtBearDiv) or (showRSIDiv and rsiBearDiv)

// Candle streaks (capitulation / euphoria)
var int downStreak = 0
var int upStreak   = 0
downStreak := close < open ? downStreak + 1 : 0
upStreak   := close > open ? upStreak + 1   : 0
capitulation = downStreak >= conStreakLen
euphoria     = upStreak   >= conStreakLen

// Price stretch from baseline EMA, in ATR units
baselineEma = ta.ema(close, trendLen)
atrVal      = ta.atr(atrLen)
stretchAtr  = (close - baselineEma) / atrVal
stretchedDown = stretchAtr <= -stretchMin
stretchedUp   = stretchAtr >=  stretchMin

// Higher timeframe WaveTrend confirmation
htfTf = htfAuto ? timeframe.from_seconds(timeframe.in_seconds(timeframe.period) * 4) : htfManual
[htfWt1, htfWt2] = request.security(syminfo.tickerid, htfTf, f_wavetrend(hlc3, wtChannelLen, wtAverageLen, wtMALen), lookahead = barmerge.lookahead_off)
htfLongOK  = not useHTF or htfWt2 <  htfBlock
htfShortOK = not useHTF or htfWt2 > -htfBlock

// ADX trend filter: do not fade a strong trend running against the signal
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
strongDownTrend = adxVal > adxMax and diMinus > diPlus
strongUpTrend   = adxVal > adxMax and diPlus  > diMinus
adxLongOK  = not useADX or not strongDownTrend
adxShortOK = not useADX or not strongUpTrend

// ============================================================================
// CROWD EXTREMITY SCORE (0-100)
// scoreOS: how extremely BEARISH the crowd is -> contrarian LONG side.
// scoreOB: how extremely BULLISH the crowd is -> contrarian SHORT side.
// ============================================================================

scoreOS = 0.0
scoreOS := scoreOS + (wtOversold  ? 15 : 0)
scoreOS := scoreOS + (wtExtremeOS ? 10 : 0)
scoreOS := scoreOS + (rsi <= rsiOversold ? 15 : 0)
scoreOS := scoreOS + (stochK <= 20 ? 10 : 0)
scoreOS := scoreOS + (mfExtremeNeg ? 15 : 0)
scoreOS := scoreOS + (capitulation ? 15 : 0)
scoreOS := scoreOS + (stretchedDown ? 20 : 0)

scoreOB = 0.0
scoreOB := scoreOB + (wtOverbought ? 15 : 0)
scoreOB := scoreOB + (wtExtremeOB  ? 10 : 0)
scoreOB := scoreOB + (rsi >= rsiOverbought ? 15 : 0)
scoreOB := scoreOB + (stochK >= 80 ? 10 : 0)
scoreOB := scoreOB + (mfExtremePos ? 15 : 0)
scoreOB := scoreOB + (euphoria     ? 15 : 0)
scoreOB := scoreOB + (stretchedUp  ? 20 : 0)

// Signed score for plotting: +ve = fade the bears (long), -ve = fade the bulls (short)
crowdScore = scoreOS - scoreOB

// ============================================================================
// SIGNALS
// ============================================================================

// Classic Cipher B momentum circles (WT cross while at OS/OB)
classicBuy  = wtCrossUp and wtOversold
classicSell = wtCrossDown and wtOverbought

// Track recent divergences so a signal a few bars after the divergence still counts
var int barsSinceBullDiv = 100000
var int barsSinceBearDiv = 100000
barsSinceBullDiv := anyBullDiv ? 0 : barsSinceBullDiv + 1
barsSinceBearDiv := anyBearDiv ? 0 : barsSinceBearDiv + 1
recentBullDiv = barsSinceBullDiv <= conDivLookback
recentBearDiv = barsSinceBearDiv <= conDivLookback

// Cooldown per direction
var int lastBuyBar  = -100000
var int lastSellBar = -100000
buyCooldownOK  = bar_index - lastBuyBar  >= cooldownBars
sellCooldownOK = bar_index - lastSellBar >= cooldownBars

// Confirmation candle
buyCandleOK  = not useCandleConfirm or close > open
sellCandleOK = not useCandleConfirm or close < open

// Contrarian signals: fade the crowd at extremes, triggered by a WT cross back,
// gated by every quality filter.
contrarianBuy  = wtCrossUp   and scoreOS >= conThreshold and (not conNeedDiv or recentBullDiv) and htfLongOK  and adxLongOK  and buyCandleOK  and buyCooldownOK
contrarianSell = wtCrossDown and scoreOB >= conThreshold and (not conNeedDiv or recentBearDiv) and htfShortOK and adxShortOK and sellCandleOK and sellCooldownOK

if contrarianBuy
    lastBuyBar := bar_index
if contrarianSell
    lastSellBar := bar_index

// Strong variants: extremity + divergence + extreme WT level all align
strongBuy  = contrarianBuy  and recentBullDiv and wtExtremeOS
strongSell = contrarianSell and recentBearDiv and wtExtremeOB

// Fade Mode: a classic momentum cross firing AT an extreme is a late-crowd warning
fadeWarnLong  = showFadeMode and wtCrossDown and wtExtremeOS
fadeWarnShort = showFadeMode and wtCrossUp   and wtExtremeOB

// ============================================================================
// PLOTS
// ============================================================================

colWT1     = color.new(#90caf9, 0)
colWT2     = color.new(#0d47a1, 20)
colVwap    = color.new(#ffe500, 45)
colBuy     = color.new(#00e676, 0)
colSell    = color.new(#ff5252, 0)
colStrongB = color.new(#00ffaa, 0)
colStrongS = color.new(#ff00aa, 0)
colScore   = color.new(#b388ff, 0)

hline(0, 'Zero', color = color.new(color.gray, 60))

// Effective (adaptive or fixed) OB/OS levels
plot(effOB1, 'Overbought 1 (effective)', color = color.new(#ff5252, 75))
plot(effOB2, 'Overbought 2 (effective)', color = color.new(#ff5252, 60), style = plot.style_circles)
plot(effOS1, 'Oversold 1 (effective)',   color = color.new(#00e676, 75))
plot(effOS2, 'Oversold 2 (effective)',   color = color.new(#00e676, 60), style = plot.style_circles)

// WaveTrend waves
plot(wt1, 'WT Wave 1', color = colWT1, style = plot.style_area)
plot(wt2, 'WT Wave 2', color = colWT2, style = plot.style_area)
plot(wtVwap, 'WT VWAP', color = colVwap, style = plot.style_area)

// Money flow area (green above zero, red below — Cipher B style)
plot(moneyFlow, 'Money Flow', color = moneyFlow > 0 ? color.new(#3fff00, 55) : color.new(#ff1100, 55), style = plot.style_area)

// RSI (scaled from 0..100 to -100..100 so it shares the WT pane)
plot((rsi - 50) * 2, 'RSI (scaled)', color = color.new(#ce93d8, 60))

// Crowd extremity score (signed)
plot(showScore ? crowdScore : na, 'Crowd Extremity Score', color = colScore, style = plot.style_stepline, linewidth = 1)

// HTF WaveTrend context (hidden by default)
plot(htfWt2, 'HTF WT2 (hidden by default)', color = color.new(#ffab40, 100), display = display.none)

// Classic Cipher B circles
plotshape(showClassicCircles and classicBuy  ? wt2 : na, 'Classic Buy Circle',  style = shape.circle, location = location.absolute, color = color.new(#00e676, 25), size = size.tiny)
plotshape(showClassicCircles and classicSell ? wt2 : na, 'Classic Sell Circle', style = shape.circle, location = location.absolute, color = color.new(#ff5252, 25), size = size.tiny)

// Divergence markers (plotted on the fractal pivot, 2 bars back)
plotshape(showWTDiv and wtBullDiv ? wt2[2] : na, 'WT Bullish Div', style = shape.labelup,   location = location.absolute, color = color.new(#00e676, 40), text = 'Bull\nDiv', textcolor = color.white, size = size.tiny, offset = -2)
plotshape(showWTDiv and wtBearDiv ? wt2[2] : na, 'WT Bearish Div', style = shape.labeldown, location = location.absolute, color = color.new(#ff5252, 40), text = 'Bear\nDiv', textcolor = color.white, size = size.tiny, offset = -2)

// Contrarian signals
plotshape(contrarianBuy and not strongBuy,   'Contrarian Buy',  style = shape.triangleup,   location = location.bottom, color = colBuy,  size = size.small)
plotshape(contrarianSell and not strongSell, 'Contrarian Sell', style = shape.triangledown, location = location.top,    color = colSell, size = size.small)
plotshape(strongBuy,  'Strong Contrarian Buy',  style = shape.triangleup,   location = location.bottom, color = colStrongB, size = size.normal)
plotshape(strongSell, 'Strong Contrarian Sell', style = shape.triangledown, location = location.top,    color = colStrongS, size = size.normal)

// Fade-mode warnings
plotshape(fadeWarnLong,  'Fade Warning (lean long)',  style = shape.diamond, location = location.bottom, color = color.new(#ffd54f, 0), size = size.tiny)
plotshape(fadeWarnShort, 'Fade Warning (lean short)', style = shape.diamond, location = location.top,    color = color.new(#ffd54f, 0), size = size.tiny)

// Labels for strong signals
if showLabels and strongBuy
    label.new(bar_index, effOS2 - 15, 'FADE THE PANIC\nStrong Buy', style = label.style_label_up, color = color.new(#00e676, 20), textcolor = color.white, size = size.small)
if showLabels and strongSell
    label.new(bar_index, effOB2 + 15, 'FADE THE EUPHORIA\nStrong Sell', style = label.style_label_down, color = color.new(#ff5252, 20), textcolor = color.white, size = size.small)

// Background tint at extreme crowd readings
bgcolor(scoreOS >= conThreshold ? color.new(#00e676, 92) : scoreOB >= conThreshold ? color.new(#ff5252, 92) : na)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(contrarianBuy,  'Contrarian Buy',         'Contrarian Cipher B: BUY — crowd extremely bearish, filters aligned, WaveTrend crossed up. Fade the panic.')
alertcondition(contrarianSell, 'Contrarian Sell',        'Contrarian Cipher B: SELL — crowd extremely bullish, filters aligned, WaveTrend crossed down. Fade the euphoria.')
alertcondition(strongBuy,      'Strong Contrarian Buy',  'Contrarian Cipher B: STRONG BUY — extreme oversold + bullish divergence + WT cross up.')
alertcondition(strongSell,     'Strong Contrarian Sell', 'Contrarian Cipher B: STRONG SELL — extreme overbought + bearish divergence + WT cross down.')
alertcondition(wtBullDiv,      'WT Bullish Divergence',  'Contrarian Cipher B: bullish divergence on WaveTrend.')
alertcondition(wtBearDiv,      'WT Bearish Divergence',  'Contrarian Cipher B: bearish divergence on WaveTrend.')
alertcondition(fadeWarnLong,   'Fade Warning (long)',    'Contrarian Cipher B: late sellers at extreme oversold — contrarian long warning.')
alertcondition(fadeWarnShort,  'Fade Warning (short)',   'Contrarian Cipher B: late buyers at extreme overbought — contrarian short warning.')

// Dynamic alert() messages: create ONE TradingView alert on this indicator with
// condition "Any alert() function call" and every enabled event below fires
// through it with live ticker / timeframe / price / score details, plus the
// bracket levels and risk-based position size ready to copy into the exchange.
alertPrefix = syminfo.ticker + ' ' + timeframe.period + ' | Contrarian Cipher B | '

// Simulated running balance: starts at Account Size and is updated by every
// resolved TP/SL trade in the winrate table (see that section below).
var float simEquity = accountSize
effAccount = compoundEquity ? simEquity : accountSize

sizeStopDist = tblAtrStop * atrVal
sizeQty      = effAccount * riskPct / 100 / sizeStopDist
sizeMargin   = sizeQty * close / leverageX
sizeTxt      = ' | qty ' + str.tostring(sizeQty, '#.####') + ' (' + str.tostring(riskPct, '#.#') + '% of $' + str.tostring(effAccount, '#.##') + ', margin $' + str.tostring(sizeMargin, '#.##') + ' @' + str.tostring(leverageX, '#') + 'x)'
buySLtxt     = ' | SL ' + str.tostring(close - sizeStopDist, format.mintick) + ' | TP ' + str.tostring(close + tblAtrTgt * atrVal, format.mintick)
sellSLtxt    = ' | SL ' + str.tostring(close + sizeStopDist, format.mintick) + ' | TP ' + str.tostring(close - tblAtrTgt * atrVal, format.mintick)

if barstate.isconfirmed
    if alertOnStrong and strongBuy
        alert(alertPrefix + 'STRONG BUY @ ' + str.tostring(close) + buySLtxt + sizeTxt + ' | score ' + str.tostring(scoreOS, '#') + '/100 | extreme oversold + divergence. Fade the panic.', alert.freq_once_per_bar_close)
    else if alertOnBuy and contrarianBuy
        alert(alertPrefix + 'BUY @ ' + str.tostring(close) + buySLtxt + sizeTxt + ' | score ' + str.tostring(scoreOS, '#') + '/100 | crowd extremely bearish, WT crossed up.', alert.freq_once_per_bar_close)
    if alertOnStrong and strongSell
        alert(alertPrefix + 'STRONG SELL @ ' + str.tostring(close) + sellSLtxt + sizeTxt + ' | score ' + str.tostring(scoreOB, '#') + '/100 | extreme overbought + divergence. Fade the euphoria.', alert.freq_once_per_bar_close)
    else if alertOnSell and contrarianSell
        alert(alertPrefix + 'SELL @ ' + str.tostring(close) + sellSLtxt + sizeTxt + ' | score ' + str.tostring(scoreOB, '#') + '/100 | crowd extremely bullish, WT crossed down.', alert.freq_once_per_bar_close)
    if alertOnDiv and wtBullDiv
        alert(alertPrefix + 'Bullish divergence on WaveTrend @ ' + str.tostring(close), alert.freq_once_per_bar_close)
    if alertOnDiv and wtBearDiv
        alert(alertPrefix + 'Bearish divergence on WaveTrend @ ' + str.tostring(close), alert.freq_once_per_bar_close)
    if alertOnFade and fadeWarnLong
        alert(alertPrefix + 'Fade warning: late sellers at extreme oversold — lean long.', alert.freq_once_per_bar_close)
    if alertOnFade and fadeWarnShort
        alert(alertPrefix + 'Fade warning: late buyers at extreme overbought — lean short.', alert.freq_once_per_bar_close)

// ============================================================================
// SIGNAL WINRATE TABLE
// Two evaluation modes:
//  - ATR Stop/Target: each signal is tracked like a real bracket order from
//    the signal close. Win = take profit touched first, loss = stop touched
//    first (if both are touched in the same bar, the stop wins — worst case).
//    This matches the strategy script's SL/TP behaviour.
//  - Fixed Horizon: win = price closed favorably `winHorizon` bars later.
// ============================================================================

f_tablePos(simple string s) =>
    switch s
        'Top Right'    => position.top_right
        'Top Left'     => position.top_left
        'Bottom Right' => position.bottom_right
        => position.bottom_left

useTpslMode = evalModeStr == 'ATR Stop/Target'

var int   buyCount   = 0
var int   buyWins    = 0
var float buySumRet  = 0.0
var int   sellCount  = 0
var int   sellWins   = 0
var float sellSumRet = 0.0

// --- Fixed Horizon mode: a signal that fired `winHorizon` bars ago matures now
if not useTpslMode and contrarianBuy[winHorizon]
    retPct = (close - close[winHorizon]) / close[winHorizon] * 100
    buyCount  := buyCount + 1
    buyWins   := buyWins + (retPct > 0 ? 1 : 0)
    buySumRet := buySumRet + retPct

if not useTpslMode and contrarianSell[winHorizon]
    retPct = (close[winHorizon] - close) / close[winHorizon] * 100
    sellCount  := sellCount + 1
    sellWins   := sellWins + (retPct > 0 ? 1 : 0)
    sellSumRet := sellSumRet + retPct

// --- ATR Stop/Target mode: track open simulated brackets until resolved
var array<float> pendEntry = array.new_float()
var array<float> pendStop  = array.new_float()
var array<float> pendTgt   = array.new_float()
var array<int>   pendDir   = array.new_int()   // 1 = long, -1 = short
var array<int>   pendBar   = array.new_int()

if useTpslMode
    if contrarianBuy
        array.push(pendEntry, close)
        array.push(pendStop,  close - tblAtrStop * atrVal)
        array.push(pendTgt,   close + tblAtrTgt  * atrVal)
        array.push(pendDir,   1)
        array.push(pendBar,   bar_index)
    if contrarianSell
        array.push(pendEntry, close)
        array.push(pendStop,  close + tblAtrStop * atrVal)
        array.push(pendTgt,   close - tblAtrTgt  * atrVal)
        array.push(pendDir,   -1)
        array.push(pendBar,   bar_index)

    if array.size(pendDir) > 0
        for i = array.size(pendDir) - 1 to 0
            // Entry is at the signal bar close; start checking from the next bar
            if bar_index > array.get(pendBar, i)
                dir    = array.get(pendDir, i)
                entryP = array.get(pendEntry, i)
                stopP  = array.get(pendStop, i)
                tgtP   = array.get(pendTgt, i)
                hitStop  = dir == 1 ? low  <= stopP : high >= stopP
                hitTgt   = dir == 1 ? high >= tgtP  : low  <= tgtP
                timedOut = bar_index - array.get(pendBar, i) >= tblTimeout
                if hitStop or hitTgt or timedOut
                    // Stop checked before target: same-bar ties count as losses (conservative)
                    exitP  = hitStop ? stopP : hitTgt ? tgtP : close
                    retPct = dir == 1 ? (exitP - entryP) / entryP * 100 : (entryP - exitP) / entryP * 100
                    isWin  = hitStop ? false : hitTgt ? true : retPct > 0
                    // Compound the simulated balance: result in R-multiples of the
                    // risked amount (riskPct% of equity at stake per trade)
                    stopPctTrade = math.abs(entryP - stopP) / entryP * 100
                    rMult = stopPctTrade > 0 ? retPct / stopPctTrade : 0.0
                    simEquity := simEquity * (1 + riskPct / 100 * rMult)
                    if dir == 1
                        buyCount  := buyCount + 1
                        buyWins   := buyWins + (isWin ? 1 : 0)
                        buySumRet := buySumRet + retPct
                    else
                        sellCount  := sellCount + 1
                        sellWins   := sellWins + (isWin ? 1 : 0)
                        sellSumRet := sellSumRet + retPct
                    array.remove(pendEntry, i)
                    array.remove(pendStop, i)
                    array.remove(pendTgt, i)
                    array.remove(pendDir, i)
                    array.remove(pendBar, i)

var table winTable = table.new(f_tablePos(tblPosStr), 4, 6, bgcolor = color.new(#1e222d, 15), border_width = 1, border_color = color.new(#434651, 50))

f_pct(int wins, int total) =>
    total > 0 ? str.tostring(100.0 * wins / total, '#.#') + '%' : '—'

f_avg(float sumRet, int total) =>
    total > 0 ? str.tostring(sumRet / total, '#.##') + '%' : '—'

if showWinTable and barstate.islast
    hdrCol  = color.new(#787b86, 0)
    txtCol  = color.white
    winCol  = color.new(#00e676, 0)
    lossCol = color.new(#ff5252, 0)
    totalCount = buyCount + sellCount
    totalWins  = buyWins + sellWins
    tblHdr = useTpslMode ? 'Signal (SL ' + str.tostring(tblAtrStop, '#.##') + ' / TP ' + str.tostring(tblAtrTgt, '#.##') + ' ATR)' : 'Signal (' + str.tostring(winHorizon) + ' bars)'
    table.cell(winTable, 0, 0, tblHdr, text_color = hdrCol, text_size = size.small)
    table.cell(winTable, 1, 0, 'Count',   text_color = hdrCol, text_size = size.small)
    table.cell(winTable, 2, 0, 'Winrate', text_color = hdrCol, text_size = size.small)
    table.cell(winTable, 3, 0, 'Avg Ret', text_color = hdrCol, text_size = size.small)
    table.cell(winTable, 0, 1, 'Buys',  text_color = winCol, text_size = size.small)
    table.cell(winTable, 1, 1, str.tostring(buyCount), text_color = txtCol, text_size = size.small)
    table.cell(winTable, 2, 1, f_pct(buyWins, buyCount), text_color = buyCount > 0 and buyWins * 2 >= buyCount ? winCol : lossCol, text_size = size.small)
    table.cell(winTable, 3, 1, f_avg(buySumRet, buyCount), text_color = buySumRet >= 0 ? winCol : lossCol, text_size = size.small)
    table.cell(winTable, 0, 2, 'Sells', text_color = lossCol, text_size = size.small)
    table.cell(winTable, 1, 2, str.tostring(sellCount), text_color = txtCol, text_size = size.small)
    table.cell(winTable, 2, 2, f_pct(sellWins, sellCount), text_color = sellCount > 0 and sellWins * 2 >= sellCount ? winCol : lossCol, text_size = size.small)
    table.cell(winTable, 3, 2, f_avg(sellSumRet, sellCount), text_color = sellSumRet >= 0 ? winCol : lossCol, text_size = size.small)
    table.cell(winTable, 0, 3, 'All',   text_color = txtCol, text_size = size.small)
    table.cell(winTable, 1, 3, str.tostring(totalCount), text_color = txtCol, text_size = size.small)
    table.cell(winTable, 2, 3, f_pct(totalWins, totalCount), text_color = totalCount > 0 and totalWins * 2 >= totalCount ? winCol : lossCol, text_size = size.small)
    table.cell(winTable, 3, 3, f_avg(buySumRet + sellSumRet, totalCount), text_color = buySumRet + sellSumRet >= 0 ? winCol : lossCol, text_size = size.small)

    // Live position sizing + approximate liquidation buffer check
    stopPctNow   = sizeStopDist / close * 100
    liqPctApprox = 100 / leverageX
    liqSafe      = stopPctNow < liqPctApprox * 0.8
    eqCol = effAccount >= accountSize ? winCol : lossCol
    table.cell(winTable, 0, 4, 'Equity $' + str.tostring(effAccount, '#.##') + (compoundEquity ? ' (compounded)' : ''), text_color = eqCol, text_size = size.small)
    table.cell(winTable, 1, 4, 'qty ' + str.tostring(sizeQty, '#.####'), text_color = txtCol, text_size = size.small)
    table.cell(winTable, 2, 4, 'risk $' + str.tostring(effAccount * riskPct / 100, '#.##') + ' (' + str.tostring(riskPct, '#.#') + '%)', text_color = txtCol, text_size = size.small)
    table.cell(winTable, 3, 4, 'margin $' + str.tostring(sizeMargin, '#.##'), text_color = txtCol, text_size = size.small)
    table.cell(winTable, 0, 5, 'Stop vs Liq @' + str.tostring(leverageX, '#') + 'x', text_color = txtCol, text_size = size.small)
    table.cell(winTable, 1, 5, 'stop ' + str.tostring(stopPctNow, '#.##') + '%', text_color = txtCol, text_size = size.small)
    table.cell(winTable, 2, 5, 'liq ~' + str.tostring(liqPctApprox, '#.##') + '%', text_color = txtCol, text_size = size.small)
    table.cell(winTable, 3, 5, liqSafe ? 'OK' : 'LIQ RISK!', text_color = liqSafe ? winCol : lossCol, text_size = size.small)
