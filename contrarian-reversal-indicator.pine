//@version=6
indicator("Contrarian Reversal Pro [Buy/Sell]", shorttitle="Contrarian Pro", overlay=true, max_labels_count=500)

// ============================================================================
//  CONTRARIAN REVERSAL PRO
//  ---------------------------------------------------------------------------
//  A contrarian (mean-reversion) indicator designed for a higher win rate by
//  requiring MULTIPLE confirmations before printing a signal:
//
//    1. Composite exhaustion score  -> RSI + Stochastic + CCI + Bollinger %B
//       must all agree the market is at an extreme (crowd is one-sided).
//    2. Price rejection             -> price must pierce the Bollinger Band
//       and then CLOSE back inside it with a reversal candle. This avoids
//       "catching a falling knife" while the move is still extending.
//    3. Optional trend filter       -> only fade moves in the direction of
//       the long-term trend (pullback buying / rally selling).
//    4. Signal cooldown             -> prevents clusters of repeated signals.
//
//  BUY  = crowd is extremely bearish and price just rejected the low extreme.
//  SELL = crowd is extremely bullish and price just rejected the high extreme.
//
//  A stats table (top-right) tracks the historical win rate of the signals on
//  the current chart so you can validate the settings per symbol/timeframe.
// ============================================================================

// ---------------------------------------------------------------- Inputs ---
grpScore   = "Exhaustion Score"
rsiLen     = input.int(14,  "RSI Length",         minval=2,  group=grpScore)
stochLen   = input.int(14,  "Stochastic Length",  minval=2,  group=grpScore)
cciLen     = input.int(20,  "CCI Length",         minval=2,  group=grpScore)
buyThresh  = input.int(20,  "Oversold Threshold (Buy Zone)",   minval=1, maxval=49, group=grpScore)
sellThresh = input.int(80,  "Overbought Threshold (Sell Zone)", minval=51, maxval=99, group=grpScore)

grpBB      = "Bollinger Rejection"
bbLen      = input.int(20,    "BB Length",      minval=2, group=grpBB)
bbMult     = input.float(2.0, "BB Multiplier",  minval=0.5, step=0.1, group=grpBB)
setupBars  = input.int(3,     "Setup Valid For (bars)", minval=1, maxval=20, group=grpBB,
     tooltip="After an extreme reading, the rejection candle must appear within this many bars.")

grpFilter  = "Filters (win-rate boosters)"
useTrend   = input.bool(true, "Use Trend Filter (EMA)", group=grpFilter,
     tooltip="BUY only above the trend EMA, SELL only below it. Fading pullbacks inside a trend wins far more often than fighting the trend.")
trendLen   = input.int(200, "Trend EMA Length", minval=10, group=grpFilter)
useVolume  = input.bool(false, "Require Volume Spike (capitulation)", group=grpFilter,
     tooltip="Signal only when volume exceeds its average, i.e. a capitulation/blow-off bar. Disable on symbols without volume data.")
volMult    = input.float(1.3, "Volume Spike Multiplier", minval=1.0, step=0.1, group=grpFilter)
cooldown   = input.int(8, "Cooldown Between Signals (bars)", minval=0, group=grpFilter)

grpStats   = "Statistics"
showStats  = input.bool(true, "Show Win-Rate Table", group=grpStats)
evalBars   = input.int(10, "Evaluate Outcome After (bars)", minval=1, maxval=100, group=grpStats,
     tooltip="A BUY wins if price is higher this many bars later; a SELL wins if price is lower.")

// ------------------------------------------------------ Exhaustion score ---
rsiVal   = ta.rsi(close, rsiLen)
stochVal = ta.sma(ta.stoch(close, high, low, stochLen), 3)

// CCI rescaled from roughly [-200, 200] to [0, 100]
cciRaw   = ta.cci(close, cciLen)
cciVal   = math.max(0.0, math.min(100.0, (cciRaw + 200) / 4))

// Bollinger %B rescaled to [0, 100]
bbBasis  = ta.sma(close, bbLen)
bbDev    = ta.stdev(close, bbLen) * bbMult
bbUpper  = bbBasis + bbDev
bbLower  = bbBasis - bbDev
bbRange  = math.max(bbUpper - bbLower, syminfo.mintick)   // guard: never divide by zero
pctB     = math.max(0.0, math.min(100.0, (close - bbLower) / bbRange * 100))

score = (rsiVal + stochVal + cciVal + pctB) / 4.0

// ------------------------------------------------------------- Conditions ---
trendEma  = ta.ema(close, trendLen)
volSma    = ta.sma(nz(volume), 20)   // computed every bar to keep the series consistent
volOk     = not useVolume or (not na(volume) and volume > volSma * volMult)

trendOkBuy  = not useTrend or close > trendEma
trendOkSell = not useTrend or close < trendEma

// Step 1: extreme reading while price is outside the band (crowd one-sided)
buySetup  = score <= buyThresh  and low  < bbLower
sellSetup = score >= sellThresh and high > bbUpper

// Step 2: rejection candle closing back inside the band within `setupBars`
// (na-guarded: ta.barssince returns na until the first setup ever occurs)
bsBuy  = ta.barssince(buySetup)
bsSell = ta.barssince(sellSetup)
buySetupRecent  = not na(bsBuy)  and bsBuy  <= setupBars - 1
sellSetupRecent = not na(bsSell) and bsSell <= setupBars - 1

buyReject  = close > bbLower and close > open and close > close[1]
sellReject = close < bbUpper and close < open and close < close[1]

rawBuy  = buySetupRecent  and buyReject  and trendOkBuy  and volOk
rawSell = sellSetupRecent and sellReject and trendOkSell and volOk

// Step 3: cooldown so signals do not cluster
var int lastSignalBar = -100000
canSignal  = (bar_index - lastSignalBar) > cooldown
buySignal  = rawBuy  and canSignal
sellSignal = rawSell and not buySignal and canSignal
if buySignal or sellSignal
    lastSignalBar := bar_index

// ------------------------------------------------------------- Win rate ---
var int buyWins   = 0
var int buyTotal  = 0
var int sellWins  = 0
var int sellTotal = 0

// Evaluate signals that fired `evalBars` ago (uses only closed, past data)
if buySignal[evalBars]
    buyTotal += 1
    if close > close[evalBars]
        buyWins += 1
if sellSignal[evalBars]
    sellTotal += 1
    if close < close[evalBars]
        sellWins += 1

// --------------------------------------------------------------- Visuals ---
plot(bbUpper, "BB Upper", color=color.new(color.gray, 60))
plot(bbLower, "BB Lower", color=color.new(color.gray, 60))
plot(bbBasis, "BB Basis", color=color.new(color.gray, 75))
plot(useTrend ? trendEma : na, "Trend EMA", color=color.new(color.orange, 30), linewidth=2)

bgcolor(score <= buyThresh  ? color.new(color.green, 92) :
        score >= sellThresh ? color.new(color.red,   92) : na)

plotshape(buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar,
     color=color.new(#089981, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar,
     color=color.new(#f23645, 0), text="SELL", textcolor=color.white, size=size.small)

// Stats table (drawn only on the last bar; cheap and safe)
var table statsTbl = table.new(position.top_right, 3, 4, border_width=1)
if showStats and barstate.islast
    totalAll = buyTotal + sellTotal
    winsAll  = buyWins + sellWins
    // multiply by 100.0 first so the division happens in float (int/int truncates)
    buyWr  = buyTotal  > 0 ? buyWins  * 100.0 / buyTotal  : 0.0
    sellWr = sellTotal > 0 ? sellWins * 100.0 / sellTotal : 0.0
    allWr  = totalAll  > 0 ? winsAll  * 100.0 / totalAll  : 0.0
    table.cell(statsTbl, 0, 0, "Signal", text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(statsTbl, 1, 0, "Count",  text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(statsTbl, 2, 0, "Win %",  text_color=color.white, bgcolor=color.new(color.gray, 20))
    table.cell(statsTbl, 0, 1, "BUY",  text_color=color.white, bgcolor=color.new(#089981, 30))
    table.cell(statsTbl, 1, 1, str.tostring(buyTotal),                  text_color=color.white, bgcolor=color.new(#089981, 60))
    table.cell(statsTbl, 2, 1, str.tostring(buyWr, "#.#") + "%",        text_color=color.white, bgcolor=color.new(#089981, 60))
    table.cell(statsTbl, 0, 2, "SELL", text_color=color.white, bgcolor=color.new(#f23645, 30))
    table.cell(statsTbl, 1, 2, str.tostring(sellTotal),                 text_color=color.white, bgcolor=color.new(#f23645, 60))
    table.cell(statsTbl, 2, 2, str.tostring(sellWr, "#.#") + "%",       text_color=color.white, bgcolor=color.new(#f23645, 60))
    table.cell(statsTbl, 0, 3, "ALL",  text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(statsTbl, 1, 3, str.tostring(totalAll),                  text_color=color.white, bgcolor=color.new(color.blue, 60))
    table.cell(statsTbl, 2, 3, str.tostring(allWr, "#.#") + "%",        text_color=color.white, bgcolor=color.new(color.blue, 60))

// ---------------------------------------------------------------- Alerts ---
alertcondition(buySignal,  title="Contrarian BUY",  message="Contrarian Pro: BUY signal on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(sellSignal, title="Contrarian SELL", message="Contrarian Pro: SELL signal on {{ticker}} ({{interval}}) at {{close}}")
